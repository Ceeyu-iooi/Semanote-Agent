# Reference only: local-web.mjs manages the ignored local configuration.
# Java service accepts these environment variables; no real credentials here.
SEMANOTE_PORT=8080
SEMANOTE_BIND_ADDRESS=127.0.0.1
SEMANOTE_NODE=node
SEMANOTE_DB_URL=jdbc:mysql://127.0.0.1:3307/semanote?characterEncoding=UTF-8&serverTimezone=UTC
SEMANOTE_DB_USER=replace-with-local-user
SEMANOTE_DB_PASSWORD=replace-with-local-password
# Model suppliers and keys are configured in the web settings and saved only under profile/runtime.
