# Reference only. The local launcher supplies the managed database credentials.
SEMANOTE_PORT=8090
SEMANOTE_BIND_ADDRESS=127.0.0.1
SEMANOTE_DB_URL=jdbc:mysql://127.0.0.1:3307/semanote
SEMANOTE_DB_USER=replace-with-local-user
SEMANOTE_DB_PASSWORD=replace-with-local-password
# Model settings and credentials stay under the ignored profile/runtime directory.
