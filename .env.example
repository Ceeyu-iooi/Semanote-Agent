# Copy to .env locally. Never commit the real key.
# Default provider: DeepSeek official Chat Completions.
SEMANOTE_PROVIDER=deepseek
DEEPSEEK_API_KEY=replace-with-your-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Explicit alternate provider: a Chat Completions-compatible service.
# Use --provider compatible; no automatic failover occurs.
COMPATIBLE_API_KEY=replace-with-your-other-key
COMPATIBLE_BASE_URL=https://your-provider.example/v1
COMPATIBLE_MODEL=replace-with-model-id
COMPATIBLE_JSON_MODE=true
# Optional vendor-specific body, excluding model/messages/stream/response_format.
COMPATIBLE_EXTRA_BODY={}

SEMANOTE_TIMEOUT_SECONDS=60
SEMANOTE_MAX_OUTPUT_TOKENS=8192
