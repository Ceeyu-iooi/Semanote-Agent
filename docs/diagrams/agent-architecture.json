  "cards": [
    {
      "dot": "cyan",
      "title": "四类任务与依赖",
      "items": [
        "分词、关键词、词性、命名实体全部必做；可分别选择或组合执行。",
        "词性使用同修订分词结果；分词失败时词性报依赖失败，关键词和实体可独立继续。",
        "冻结契约 1.0.0：Unicode 码点区间、UD 17 类词性、原文关键词及五类实体。"
      ]
    },
    {
      "dot": "emerald",
      "title": "供应商与数据边界",
      "items": [
        "首选 DeepSeek；其他兼容 Chat Completions 的服务显式配置，不自动换供应商。",
        "本次仅授权当前 DeepSeek 的代表性 CSV 样本；不扩大到全库或其他服务。",
        "原文中的指令只作待标注数据，模型响应只解析和校验。"
      ]
    },
    {
      "dot": "rose",
      "title": "版本、错误与阶段边界",
      "items": [
        "合法零结果、未执行、调用失败和校验失败分别表达，不返回伪成功。",
        "重新推理只新增自动候选，不覆盖人工版或静默迁移旧区间。",
        "Web 后端接收真实图层检查点，界面只对已返回结果播放呈现动画。"
      ]
    }
  ]
